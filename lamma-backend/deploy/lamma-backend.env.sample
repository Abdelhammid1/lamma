# EnvironmentFile sample — copy to /etc/lamma-backend.env, edit, then
# `chmod 600 /etc/lamma-backend.env; chown lamma:lamma /etc/lamma-backend.env`

# ---------- Flask ----------
SECRET_KEY=change-me-to-64-random-chars

# ---------- Database ----------
DATABASE_URL=sqlite:////var/lib/lamma-backend/app.db

# ---------- GitHub proxy ----------
# Fine-grained PAT with Contents: Read + Write on birthday-media only.
GITHUB_TOKEN=github_pat_XXXXXXXXXXXXXXXXXXXXXX
MEDIA_OWNER=zyadwael
MEDIA_REPO=birthday-media
MEDIA_BRANCH=main

# ---------- Public domain ----------
PUBLIC_DOMAIN=manasety.ai

# ---------- Uploads staging ----------
UPLOAD_STAGING_DIR=/var/lib/lamma-backend/uploads

# ---------- Rate limits ----------
# Use memory:// for a single-worker gunicorn. For multi-worker, run Redis
# locally and switch to redis://localhost:6379.
RATELIMIT_STORAGE_URI=memory://

# ---------- Cron ----------
SCHEDULER_ENABLED=1
