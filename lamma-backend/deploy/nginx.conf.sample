# nginx location blocks for `lamma.manasety.ai`. Add these inside your
# existing `server { … }` for the vhost. Same-origin means no CORS is
# needed — the browser sees `/api/…` and `/admin/…` on the same host
# as the static frontend.
#
# Reload after changes:
#   sudo nginx -t && sudo systemctl reload nginx

# 1. Upload cap: uploads.py refuses files over 300 MB; add room for the
#    multipart envelope.
client_max_body_size 310m;

# 2. Public JSON API + admin panel proxied to gunicorn on 127.0.0.1:8010.
location /api/ {
    proxy_pass         http://127.0.0.1:8010;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;

    # Uploads can be slow on mobile networks: nginx buffers the whole
    # body, then passes it to gunicorn in one burst so a worker isn't
    # tied up for the duration of a slow upload.
    proxy_request_buffering on;
}

location /admin {
    proxy_pass         http://127.0.0.1:8010;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
}
location /admin/ {
    proxy_pass         http://127.0.0.1:8010;
    proxy_set_header   Host              $host;
    proxy_set_header   X-Real-IP         $remote_addr;
    proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header   X-Forwarded-Proto $scheme;
}

# 2b. Invitation pages go through Flask so WhatsApp / Facebook link
# previews show the couple's names, date and photo. Flask answers 404
# for anything it can't enhance, and every error falls back to the
# plain static page — the invitation never goes down with the backend.
location ~ ^/(wedding|wedding-noir|wedding-burgundy|wedding-wizard|engagement|qiraya|sobou|birthday-elegant)/[a-z0-9][a-z0-9-]*/?$ {
    proxy_pass             http://127.0.0.1:8010;   # same target as /api/ above
    proxy_set_header       Host              $host;
    proxy_set_header       X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header       X-Forwarded-Proto $scheme;
    proxy_connect_timeout  2s;
    proxy_read_timeout     5s;
    proxy_intercept_errors on;
    error_page 404 500 502 503 504 = @static_invitation;
}
location @static_invitation {
    rewrite ^/([a-z-]+)/ /$1/index.html last;
}

# 3. Everything else = the static frontend (the lamma repo). Adjust path.
location / {
    root       /var/www/lamma-static;
    try_files  $uri $uri/ /index.html;
}
