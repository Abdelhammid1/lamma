# Cloudflare Pages URL routing for lamma.manasety.ai
#
# / (root)         → index.html   (landing, default behavior)
# /admin, /admin/  → admin.html   (admin panel)
# /<slug>          → birthday.html (public template resolves slug from URL path)
#
# Static assets (logo.jpg, css/*, js/*, favicon) are served directly BEFORE
# these rewrites are checked, so they always work as normal files.

/                /index.html     200
/admin           /admin.html     200
/admin/          /admin.html     200
/*               /birthday.html  200
